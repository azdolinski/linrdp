# linrdp with a logon screen drawn by the server, on its own port.
#
# This is the path for deployments that want nothing to do with PAM
# integration. Nothing is stored and nothing is provisioned: the client sends
# no credentials, linrdp draws a login form, and what you type there goes
# straight to /etc/shadow and PAM. Every client works, mstsc included — it is
# exactly what mstsc expects from a server that does not offer NLA.
#
# The form is drawn on an X server of its own, owned by linrdp, with nobody's
# session on it, so showing it before anyone has authenticated reveals
# nothing. Only once the form accepts does the worker move to the user's own
# desktop; it can never move back.
#
# The other instance (deploy/linrdp.service, port 3389) uses `--auth both`:
# the client's own credential prompt, with the password learned by the PAM
# capture in deploy/pam-capture. Run either, or both.
#
# Both instances share /run/linrdp and the display range, which is
# deliberate: display numbers are handed out under a flock, so a user who
# arrives on either port lands on their own single session.
#
# Install:
#   sudo install -m644 deploy/linrdp-alt-port.service \
#     /etc/systemd/system/linrdp-alt-port.service
#   sudo systemctl enable --now linrdp-alt-port
[Unit]
Description=LinRDP - logon screen drawn by the server (port 3390)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/linrdp --supervisor --auth greeter --bind-addr 0.0.0.0:3390
Environment=LINRDP_LOG=info
# Enables the AVC444v2 layout (full-resolution chroma) where the client
# negotiates cap version 10.6. A quality setting and nothing more: the idle
# bandwidth storm this line was once credited with curing came from the tile
# diff comparing unrelated pixels of the two frames, and that is fixed in
# capture.rs. Full-resolution chroma is still worth having, so it stays on.
Environment=LINRDP_AVC444V2=1
# No audio configuration here, deliberately — and PULSE_SERVER in particular
# would be actively wrong. Every session has a PulseAudio daemon of its own;
# linrdp finds it through the session gate, the same place it gets the
# display, and creates the sink and the microphone source inside it. A
# PULSE_SERVER here overrides that for every session at once, which is
# precisely how one account's desktop audio came to be streamed to every
# client on this port. Nothing to add: the sessions configure themselves.
# Root is needed to read /etc/shadow, open PAM sessions, and start each
# session's X server as its own user.
User=root
Restart=on-failure
RestartSec=2
# Sessions outlive the connection that created them and are owned by keeper
# processes re-parented to init; stopping this unit must not take the
# desktops with it.
KillMode=process

[Install]
WantedBy=multi-user.target
