# Example systemd unit: linrdp serving per-user desktops.
#
# Install to /etc/systemd/system/linrdp.service, copy linrdp to
# /usr/local/bin/, wire credential capture (deploy/pam-capture — without it
# every login is refused), then: systemctl enable --now linrdp
#
# No DISPLAY or XAUTHORITY here, deliberately. Each connection gets its own
# X server, started by a keeper process that owns the session for its whole
# life, and an ambient display in this unit's environment is exactly what a
# worker must never be able to fall back to: it is another user's screen.
# The gate in linrdp refuses it, and this file does not offer it.
#
# For the single shared-screen mode (the mstsc /admin equivalent) add
# --console and set DISPLAY/XAUTHORITY for the screen to serve.
[Unit]
Description=LinRDP - RDP server for Linux
After=network-online.target
Wants=network-online.target

[Service]
# --supervisor accepts on the bind address and forks one worker per
# connection, so two people can work at once without sharing a desktop.
ExecStart=/usr/local/bin/linrdp --supervisor --bind-addr 0.0.0.0:3389
Environment=LINRDP_LOG=info
# Enables the AVC444v2 layout (full-resolution chroma) where the client
# negotiates cap version 10.6. A quality setting and nothing more: the idle
# bandwidth storm this line was once credited with curing came from the tile
# diff comparing unrelated pixels of the two frames, and that is fixed in
# capture.rs. Full-resolution chroma is still worth having, so it stays on.
Environment=LINRDP_AVC444V2=1
# No audio configuration here, deliberately — and PULSE_SERVER in particular
# would be actively wrong. Every session has a PulseAudio daemon of its own;
# linrdp finds it through the session gate, the same place it gets the
# display, and creates the sink and the microphone source inside it. A
# PULSE_SERVER here overrides that for every session at once, which is
# precisely how one account's desktop audio came to be streamed to every
# client on this port. Nothing to add: the sessions configure themselves.
# Root is needed to read /etc/shadow, open PAM sessions, and start each
# session's X server as its own user.
User=root
Restart=on-failure
RestartSec=2
# Sessions outlive the connection that created them and are owned by keeper
# processes re-parented to init; stopping this unit must not take the
# desktops with it.
KillMode=process

[Install]
WantedBy=multi-user.target
